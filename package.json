{
  "name": "apimigrate",
  "version": "0.1.0",
  "private": true,
  "description": "API migration agent — scan codebases against API change manifests, apply codemods, and open PRs",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
